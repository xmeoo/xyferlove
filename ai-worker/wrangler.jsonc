{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xyfer-ai",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "CHAT_DB",
    "database_name": "xyfer-chat",
    "database_id": "94b37139-0305-4c0a-b40f-5e905843d3fa"
  }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "deleted_classes": ["ChatRoom"] }
  ]
}
